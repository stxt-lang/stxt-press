<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.stxt</groupId>
    <artifactId>stxt-press</artifactId>
    <version>0.5.0</version>
    <packaging>jar</packaging>

    <!-- A service, not a library: it is distributed as a jar of the GitHub releases and as a Docker image, not on
         Maven Central. That is why there is no release profile, nor sources and javadoc jars. -->
    <name>STXT Press</name>
    <description>PDF and SVG generation service for STXT layout documents, built on dev.stxt:stxt-pdf.</description>
    <url>https://github.com/stxt-lang/stxt-press</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/stxt-lang/stxt-press.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/stxt-lang/stxt-press.git</developerConnection>
        <url>https://github.com/stxt-lang/stxt-press</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Reproducible build: fixes the dates inside the jar. Updated on each release. -->
        <project.build.outputTimestamp>2026-11-07T00:00:00Z</project.build.outputTimestamp>
        <junit.version>5.10.2</junit.version>
        <!-- How npm installs the dependencies of web/: install, which keeps node_modules from one build to the next,
             or ci (-Dnpm.install=ci, in the CI and for the jar of a version), which installs exactly those of
             web/package-lock.json, checked against their hashes, and fails if the lock does not fit package.json. -->
        <npm.install>install</npm.install>
    </properties>

    <dependencies>
        <!-- Official STXT parser and validator. The same version as the one stxt-pdf depends on: the enforcer's
             dependencyConvergence fails if they differ.
             Latest version at https://central.sonatype.com/artifact/dev.stxt/stxt-core -->
        <dependency>
            <groupId>dev.stxt</groupId>
            <artifactId>stxt-core</artifactId>
            <version>1.0.3</version>
        </dependency>

        <!-- The layout engine: reads the layout documents (dev.stxt.pdf) and writes the PDF and the SVG pages.
             Latest version at https://central.sonatype.com/artifact/dev.stxt/stxt-pdf -->
        <dependency>
            <groupId>dev.stxt</groupId>
            <artifactId>stxt-pdf</artifactId>
            <version>0.18.0</version>
        </dependency>

        <!-- The fill of the Slots of a layout document with JSON data (FillJson), before converting it. Its stxt-core
             is the one above.
             Latest version at https://central.sonatype.com/artifact/dev.stxt/stxt-transform -->
        <dependency>
            <groupId>dev.stxt</groupId>
            <artifactId>stxt-transform</artifactId>
            <version>0.1.0</version>
        </dependency>

        <!-- The JSON of the HTTP service: the body of /render and the responses. The data of a template (/print) are
             not read with it: they go to FillJson as they come.
             Latest version at https://central.sonatype.com/artifact/com.fasterxml.jackson.core/jackson-databind -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.22.4</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Build rules, checked first (validate): the JDK the code is written for, and a single version of each
                 dependency in the tree. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                </requireJavaVersion>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- The web editor (web/, TypeScript bundled with esbuild): Node is installed in target/ (the download is
                 kept in the local Maven repository), npm installs the dependencies of web/ (npm.install), the build
                 leaves editor.js, editor.css and index.html in target/classes/editor, which goes into the jar, and
                 npm test runs the tests of the page with the Java ones. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>2.0.2</version>
                <configuration>
                    <workingDirectory>web</workingDirectory>
                    <installDirectory>${project.build.directory}</installDirectory>
                    <nodeVersion>v22.19.0</nodeVersion>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>${npm.install} --no-audit --no-fund</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-test</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>test</phase>
                        <configuration>
                            <arguments>test</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Every javac warning is shown, without failing the build (no -Werror). -->
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                    <showWarnings>true</showWarnings>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- JSVG, which stxt-pdf uses for SVG images, draws with AWT: the service never has a display.
                         The JDK closes a request that has not arrived whole in 3 s, so that ServerLifecycleTest sees a slow
                         client lose its thread without waiting the 30 s of start (PressServer.limitTimes); the JDK reads
                         it once per JVM, so it goes here and not in the test. -->
                    <argLine>-Djava.awt.headless=true -Dsun.net.httpserver.maxReqTime=3</argLine>
                </configuration>
            </plugin>

            <!-- Packaging. The version is pinned so that the build does not depend on the default one of each
                 Maven version. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <!-- Implementation-Version: the version that the command line prints. -->
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                        <manifestEntries>
                            <!-- Stable module name for JPMS consumers, while there is no module-info.java. -->
                            <Automatic-Module-Name>dev.stxt.press</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- The jar of the release is a single file that runs with java -jar: the classes of the service and of
                 every dependency (stxt-pdf, PDFBox, Jackson...), with dev.stxt.press.cli.Main as the Main-Class. It
                 replaces the jar of the project; the one without dependencies stays as original-stxt-press-*.jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Not published on Maven Central: no pom without the dependencies is needed. -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <!-- The signatures of a jar are not valid once its classes are in another one,
                                         and module-info only describes the jar it came from. -->
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <!-- A list of the dependencies of each Apache jar, generated; not a license. -->
                                        <exclude>META-INF/DEPENDENCIES</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <!-- The Maven descriptor of the project itself: Eclipse (m2e) rewrites its
                                         pom.properties in target/classes with the date and the path of the project,
                                         which would change the jar of server/, kept in git, on every build. Nothing
                                         reads it: the version is that of the manifest. -->
                                    <artifact>dev.stxt:stxt-press</artifact>
                                    <excludes>
                                        <exclude>META-INF/maven/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.stxt.press.cli.Main</mainClass>
                                    <manifestEntries>
                                        <!-- Jackson and others carry classes for newer JDKs under META-INF/versions. -->
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- The single jar, without version, into the server folder (server/stxt-press.jar), so that the folder is
                 a whole server: copied anywhere, its start.sh or start.bat starts it. It is kept in git, for those who
                 download the folder. After the shade, which is declared before in the same phase. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>server-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                        tofile="${project.basedir}/server/stxt-press.jar" preservelastmodified="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
