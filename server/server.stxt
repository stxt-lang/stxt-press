# A server of stxt-press, started by start.sh or start.bat (java -jar stxt-press.jar start --config server.stxt).
# Every node is optional; the commented ones show their default. Relative paths are relative to this folder, so the
# folder can be copied or moved as it is. Each node is described in the README of stxt-press, "Configuration".
Server (dev.stxt.press):
	# 127.0.0.1 answers only this machine; 0.0.0.0, every address of the machine (in a container, for example).
	Host: 127.0.0.1
	Port: 8082
	# The environment variable with the token. Without Token env, every route answers without a token.
	# Token env: STXT_PRESS_TOKEN
	# Reading the resources and converting each template once before answering; until then every route answers 503.
	# Warm up: true
	# The fonts in fonts/, one folder for each family, and the images in images/, by the path a document gives them
	# (Image: examples/menu/emblem.svg).
	Resource folder: resources
	# The templates of /print/templates: each one with its document, its styles and its sample data.
	Template folder: templates
	# The documents of /print/documents: layout documents converted as they are, each one with its styles.
	Document folder: documents
	Routes:
		# Editor: true
		# Render: true
		# Templates: true
		# Documents: true
		# The Save of the editor, which writes the files of the templates and the documents of these folders. Off by
		# default; on here, for a server of this machine. Off for a server open to others without a token.
		Save: true
	# Limits:
	#     Max body size: 2097152
	#     Timeout: 30
	#     Concurrent conversions: 4
	#     Max pages: 2000
	# Template options:
	#     PDF UA: 1
	# The producer the PDFs name; by default stxt-press and stxt-pdf with their versions.
	# Producer: stxt-press 0.1.0 (stxt-pdf 0.17.0)
