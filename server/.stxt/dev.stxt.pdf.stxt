			Child: Id
				Max: 1
			Child: Style
				Max: 1
			Child: Link
				Max: 1
			Child: Box
				Max: 1
			Child: Typography
				Max: 1
			Child: Break
				Max: 1
			Child: Direction
				Max: 1
