				Max: 1
			Child: Column count
				Max: 1
			Child: Min column width
				Max: 1
			Child: Gap
				Max: 1
			Child: Separator
				Max: 1
			Child: Separator color
				Max: 1
			Child: Separator style
				Max: 1
