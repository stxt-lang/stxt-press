	Node: Columns
		Type: GROUP
		Description: Block in columns: its content fills the first column, continues in the next one and, at the end of the page, continues in the first column of the next page. Column count, Min column width or both set the columns.
		Children:
			Child: Id
				Max: 1
			Child: Style
				Max: 1
			Child: Link
				Max: 1
			Child: Box
				Max: 1
			Child: Typography
				Max: 1
