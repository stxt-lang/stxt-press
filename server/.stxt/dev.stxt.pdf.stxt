			Child: Columns
			Child: Frame
			Child: Overlay
			Child: Page overlay
			Child: Footnote
	Node: Overlay
		Type: GROUP
		Description: Superimposed block, out of flow: it takes no space and is placed with Offset in the Frame, Overlay or Page overlay that contains it (or, if there is none, in the page area).
		Children:
			Child: Id
				Max: 1
			Child: Style
				Max: 1
			Child: Link
				Max: 1
