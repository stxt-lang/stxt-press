# What the footnote documents of this folder share: paragraphs that read the calls [^id], the typography of the notes
# and their spacing.
Styles (dev.stxt.pdf):
	For element: Paragraph
		Typography:
			Markup: markdown
	For element: Footnote area
		Typography:
			Size: 8
			Line height: 11
	For element: Footnote
		Box:
			Margin: 0 0 3 0
		For element: Paragraph
			Box:
				Margin: 0
