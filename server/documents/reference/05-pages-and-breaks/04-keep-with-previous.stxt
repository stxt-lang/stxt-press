		Block:
			Style: filler
			Box:
				Height: 290
			Text: A filler block, 290 points high, to bring the total near the end of the page.
		Block:
			Style: marked
			Text: Total due: 2,630.00 EUR
				Typography:
					Bold: true
		Block:
			Style: marked
			Box:
				Height: 110
			Break:
				Keep with previous: true
				Keep together: true
