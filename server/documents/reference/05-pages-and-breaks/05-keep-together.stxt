# Pages and breaks: Keep together moves a box whole to the next page instead of splitting it.
Document (dev.stxt.pdf):
	Language: en
	Title: Pages and breaks · Keep together
	Page:
		Paper: A5
		Margin: 15mm
	Page overlay:
		Offset: auto 0 -24 0
		Text: Page {page} of {pages}
			Typography:
