# Tables: a cell without a value holds elements: paragraphs, a list, an image or another table.
Document (dev.stxt.pdf):
	Language: en
	Title: Tables · Elements in a cell
	Page:
		Paper: A4
		Margin: 20mm
	Styles:
		For element: Cell
			Trim margins: both
			Box:
				Border: 0.5
				Border color: rule
		For element: Header cell
			Typography:
				Bold: true
