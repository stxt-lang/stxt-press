					Cell: Design
					Cell: 1,200.00
				Row:
					Box:
						Background: tint
						Corner radius: 4
					Cell: Layout, a row with a rounded band
					Cell: 800.00
				Row:
					Cell: Printing
					Cell: 600.00
			Footer rows:
				Row:
					Id: total
					Style: total
					Box:
						Background: sand
						Border: 1 0 0 0
