# The box: the contrast between a text and what lies beneath it, which the conversion checks.
Document (dev.stxt.pdf):
	Language: en
	Title: The box · Contrast
	Page:
		Paper: A4
		Margin: 20mm
	Styles:
		For style: row
			Gap: 12
			Box:
				Margin: 0 0 12 0
		For style: chip
			Grow: 1
