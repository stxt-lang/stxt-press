# Styles: For element, a rule for every element of one type.
Document (dev.stxt.pdf):
	Language: en
	Title: Styles · For element
	Page:
		Paper: A4
		Margin: 20mm
	Styles:
		For element: Paragraph
			Typography:
				Font: IBM Plex Serif
				Size: 11
				Line height: 16
				Align: justify
			Box:
				Margin: 0 0 10 0
