# Block: a Block with Side left or right, and the paragraphs that follow it running beside it.
Document (dev.stxt.pdf):
	Language: en
	Title: Block · Side boxes
	Page:
		Paper: A4
		Margin: 20mm
	Styles:
		For style: aside
			Box:
				Width: 150
				Padding: 8
				Background: tint
		For style: caption
			Typography:
				Size: 8
