				Background: #D4E8C2
	Section:
		Text: Layers and rotation
			Style: topic
		Heading 1:
			Text: Painting order
		Paragraph: Boxes that overlap are painted in the order of the document, so the last one goes on top. `Layer` changes that order: among the positioned boxes of one container, a higher `Layer` is painted later. Both stages hold the same three cards in the same order.
			Style: intro
		Text: No Layer: document order, card 3 on top
			Style: label
		Frame:
			Style: stage
			Overlay:
				Offset: 20 auto auto 20
				Text: Card 1
					Style: card first
			Overlay:
				Offset: 40 auto auto 140
				Text: Card 2
					Style: card second
			Overlay:
				Offset: 60 auto auto 260
				Text: Card 3
					Style: card third
		Text: Layer: 3, 2, 1  (card 1 on top)
			Style: label
		Frame:
			Style: stage
			Overlay:
				Offset: 20 auto auto 20
				Layer: 3
				Text: Card 1  (Layer: 3)
					Style: card first
					Typography:
						Align: right
			Overlay:
				Offset: 40 auto auto 140
				Layer: 2
