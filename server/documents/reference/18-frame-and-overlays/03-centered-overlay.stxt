			Style: stage
			Overlay:
				Offset: 0
				Box:
					Width: 160
					Height: 50
					Margin: auto
					Background: accent
				Text: Centered on both axes
					Style: badge
		Text: Offset: 0 auto 0 20, Height: 50, Margin: auto 0
