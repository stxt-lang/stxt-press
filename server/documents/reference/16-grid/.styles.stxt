# The look of the Grid documents: each item is a tile and each grid has a frame, so that the tracks show.
Styles (dev.stxt.pdf):
	For style: tile
		Box:
			Padding: 5 6
			Background: accent
		Typography:
			Color: #FFFFFF
			Size: 9
			Line height: 12
	For style: pale
		Box:
			Padding: 5 6
			Background: sand
		Typography:
			Size: 9
			Line height: 12
	For element: Grid
		Box:
			Margin: 0 0 14 0
			Border: 0.5
			Border color: rule
			Background: tint
