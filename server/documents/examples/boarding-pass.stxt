									Text: 14 Jul 2026
										Style: value
							Area:
								Block:
									Text: Boarding
										Style: label
									Text: 07:00
										Style: value accent
							Area:
								Block:
									Text: Gate
										Style: label
									Text: 14
										Style: value accent
							Area:
								Block:
									Text: Seat
										Style: label
									Text: 14C
										Style: value accent
							Area:
								Block:
									Text: Zone
										Style: label
									Text: 3
										Style: value
						Stack:
							Style: scan
							Item:
								Barcode: M1HALVORSEN/INGRID    EK7Q2MP LISOSLNW 0418 195Y014C0057 100
									Id: bcbp-outbound
									Barcode format: pdf417
									Alt: PDF417 boarding pass barcode for flight NW418, seat 14C
									Style: pdf417
							Item:
								Grow: 1
								Paragraph: The gate closes **20 minutes** before departure. Hand luggage: one bag of up to 8 kg and one personal item.
									Style: note
			Area:
				Block:
					Style: stub
					Text: Northwind Air
