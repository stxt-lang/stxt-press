# Styles of the resume template: those of the "resume" example of stxt-pdf, with its base typography.
Styles (dev.stxt.pdf):
	For element: Document
		Typography:
			Font: IBM Plex Sans
			Size: 9
			Line height: 13.5
			Color: #26323A
	For element: Heading 1
		Typography:
			Size: 30
			Line height: 34
			Weight: 300
			Color: #134E4A
	For element: Heading 2
		Typography:
			Size: 10
			Line height: 14
			Weight: 600
			Color: #1F7A7A
			Case: uppercase
			Letter spacing: 0.8
		Box:
			Margin: 20 0 9 0
			Padding: 0 0 4 0
			Border: 0 0 1 0
			Border color: #BFD9D7
	For element: Paragraph
		Box:
			Margin: 0 0 6 0
		Typography:
			Markup: markdown
	For element: List
		Marker: bullet
		Box:
			Padding: 0 0 0 11
	For style: side
		Box:
			Background: #134E4A
			Padding: 34 22
		Typography:
			Color: #FFFFFF
	For style: side-title
		Typography:
			Size: 8
			Weight: 600
			Color: #8FD1CC
			Case: uppercase
			Letter spacing: 0.8
		Box:
			Margin: 20 0 8 0
	For style: track
		Box:
			Height: 3
			Corner radius: 1.5
			Background: #2F7370
			Margin: 3 0 9 0
	For style: fill
		Box:
			Height: 3
			Corner radius: 1.5
			Background: #FFFFFF
	For style: dates
		Typography:
			Weight: 500
			Color: #1F7A7A
	For style: role
		Typography:
			Weight: 600
			Size: 10
	For style: place
		Typography:
			Color: #697882
		Box:
			Margin: 0 0 4 0
	For style: figure
		Typography:
			Size: 24
			Line height: 28
			Weight: 300
			Color: #1F7A7A
	For style: caption
		Typography:
			Size: 7.5
			Color: #697882
