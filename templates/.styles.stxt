# Styles of every template of the folder: the base typography. The styles of a folder and those of a template go
# after these, so the nearest one wins.
Styles (dev.stxt.pdf):
	For element: Document
		Typography:
			Font: IBM Plex Sans
			Size: 9
			Line height: 13
			Color: #2B2420
	For element: Page overlay
		Typography:
			Size: 7.5
			Color: #7A6A5C
